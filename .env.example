# Copy to .env.local and adjust. .env.local is git-ignored; this file is not, so never put secrets here.
# Hospital name, colours, doctor and contact details live in src/config/hospital.ts, not here.

# Optional: only if you deploy under a sub-folder (e.g. /ivf). Leave empty for the domain root.
NEXT_PUBLIC_BASE_PATH=

# Optional: read content from a live WordPress backend that mirrors the content/*.json field layout.
# Leave unset to use the local /content files.
# CMS_API_BASE=https://cms.example.com/index.php?rest_route=
# CMS_LINK_HOSTS=
# CMS_REVALIDATE=300
# CMS_TIMEOUT_MS=8000
